HOST=your_host
PORT=your_port

DB_TYPE=your_database_type
DB_HOST=your_database_host
DB_PORT=your_database_port
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

CORS_ORIGIN=http://localhost:5173

JWT_SECRET=your_secret
JWT_EXPIRES_IN=your_expiration
# Minutos de vigencia del código OTP de la verificación en dos pasos (por defecto 5)
OTP_EXPIRES_MINUTES=5

# Nº de proxies entre el cliente y la API (nginx = 1). Necesario para que el
# límite por IP vea la IP real del cliente. Vacío si la API está expuesta directo.
TRUST_PROXY=
# Límite de peticiones por IP: máximo por ventana y duración de la ventana (ms)
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# Credenciales de las cuentas iniciales. Vacías = valores públicos por defecto.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_PERSONNEL_EMAIL=
SEED_PERSONNEL_PASSWORD=

# Carpeta donde se guardan los instaladores (APK/DMG/EXE) que sube el admin.
# En Docker es un volumen; si falta, ./storage/releases.
RELEASES_DIR=./storage/releases
# Tamaño máximo de un instalable, en MB.
RELEASE_MAX_MB=500
