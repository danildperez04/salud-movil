{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/global-setup.ts",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "^(?!.*node_modules/(@nestjs/schedule|@nestjs/cache-manager|@nestjs/swagger)/).*node_modules"
  ]
}
