# Reverse proxy + servidor del panel web.
#
# El nginx oficial sustituye las variables de entorno definidas (API_UPSTREAM,
# DNS_RESOLVER) al arrancar y escribe el resultado en /etc/nginx/conf.d/. Las
# variables propias de nginx ($host, $uri...) no se tocan.
#
#   /       -> panel web (SPA estática)
#   /api/*  -> API NestJS (se quita el prefijo /api antes de reenviar)
#
# CORS: panel y API se sirven desde el mismo origen, así que el navegador no
# hace peticiones cross-origin. Las cabeceras CORS las pone SOLO el API
# (CORS_ORIGIN); nginx no debe añadirlas, o llegarían duplicadas y el navegador
# rechazaría la respuesta.

# Si hay otro proxy/balanceador delante (Cloudflare, ALB...), conserva su valor;
# si no, usa el esquema de esta conexión.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 2m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/xml image/svg+xml;

    # Liveness de nginx (no toca el API). Para el estado del API: /api/health.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ------------------------------------------------------------------ API --
    location /api/ {
        # Docker resuelve el nombre del servicio en cada petición (cachea 10 s):
        # si el contenedor del API se recrea y cambia de IP, nginx lo sigue.
        # Con un `proxy_pass` estático la IP se fijaría al arrancar y daría 502.
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};

        # Quita /api/. Con variable en proxy_pass, nginx no reescribe la URI por
        # sí solo: hay que hacerlo aquí (la query string se conserva).
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Se AÑADE la IP del cliente a la cadena existente. El API usa
        # TRUST_PROXY=<nº de proxies> para tomar la IP correcta sin fiarse de lo
        # que el cliente haya puesto al principio de la cabecera.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        # Los errores del upstream devuelven JSON, como el resto del API.
        proxy_intercept_errors off;
    }

    # El API no se sirve bajo /api sin barra final.
    location = /api {
        return 308 /api/;
    }

    # ------------------------------------------------------------------ SPA --
    # Archivos con hash en el nombre (Vite): se pueden cachear para siempre.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html nunca se cachea: referencia los bundles con hash vigentes.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Fallback de SPA: React Router resuelve las rutas del lado cliente, así que
    # refrescar /patients/1 debe devolver index.html y no un 404.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
