# Variables para `docker compose`. Copiar a `.env` (que NO se versiona).
#   cp .env.example .env

# ---- OBLIGATORIAS -----------------------------------------------------------
# Contraseña de PostgreSQL. Generar una: openssl rand -base64 24
DB_PASSWORD=
# Secreto con el que se firman los JWT. Generar: openssl rand -base64 48
JWT_SECRET=

# ---- Red --------------------------------------------------------------------
# Puerto del host en el que se publica nginx.
HTTP_PORT=80
# URL pública con la que los usuarios abren el panel (esquema + host [+ puerto],
# sin barra final). Se usa como CORS_ORIGIN por defecto.
PUBLIC_URL=http://localhost
# Orígenes extra autorizados por CORS, separados por coma. Déjalo vacío si el
# panel se sirve desde nginx; solo hace falta para otro frontend en otro dominio.
CORS_ORIGIN=
# Nº de proxies entre el cliente y la API. 1 = solo nginx. Súbelo a 2 si hay un
# balanceador/CDN (Cloudflare, ALB, Traefik...) delante de nginx.
TRUST_PROXY=1

# ---- Base de datos ----------------------------------------------------------
DB_USER=salud_movil
DB_NAME=salud_movil
# Déjalo comentado para usar el contenedor `db`. Para una base externa
# (Supabase, RDS...) define host y puerto y levanta con:
#   docker compose up -d --no-deps api web
# DB_HOST=
# DB_PORT=5432

# ---- API --------------------------------------------------------------------
JWT_EXPIRES_IN=1d
OTP_EXPIRES_MINUTES=5
# Peticiones permitidas por IP en cada ventana (TTL en ms).
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
# Aplica las migraciones al arrancar el contenedor. Pon false si las ejecutas
# aparte o corres varias réplicas.
RUN_MIGRATIONS=true

# ---- Cuentas iniciales (seed) -----------------------------------------------
# Si se dejan vacías se crean con contraseñas públicas conocidas
# (Admin123! / Personal123!). Defínelas ANTES del primer arranque en producción:
# el seed solo crea las cuentas si no existen.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_PERSONNEL_EMAIL=
SEED_PERSONNEL_PASSWORD=

# ---- Build ------------------------------------------------------------------
# URL del API que se incrusta en el panel al compilar. `/api` (relativa) es lo
# correcto salvo que el API viva en otro dominio.
VITE_API_URL=/api
IMAGE_TAG=latest
